# Environment Configuration
PROJECT_NAME="Career Matching System"
ENVIRONMENT="development"

# ASP.NET Core & Security
JWT_SECRET="YOUR_SUPER_SECRET_JWT_KEY_HERE_MIN_32_CHARS"
JWT_ISSUER="CareerMatchApi"
JWT_AUDIENCE="CareerMatchClients"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Microsoft SQL Server)
MSSQL_SERVER="localhost"
MSSQL_DATABASE="CareerMatchDB"
MSSQL_USER="sa"
MSSQL_PASSWORD="YourStrongPassword123!"
CONNECTION_STRING="Server=localhost;Database=CareerMatchDB;User Id=sa;Password=YourStrongPassword123!;TrustServerCertificate=True;"

# AWS Storage (Optional for Production)
AWS_ACCESS_KEY_ID="your_access_key"
AWS_SECRET_ACCESS_KEY="your_secret_key"
AWS_S3_BUCKET_NAME="career-matching-cvs"
